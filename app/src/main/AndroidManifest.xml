<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Только ради точки на карте: спрашивается в момент отправки, не при запуске. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Только ради голосовых: спрашивается на первом удержании микрофона. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecretMessanger">

        <!--
            adjustResize обязателен, и это не вкусовщина. По умолчанию система выбирает
            adjustPan: она проматывает окно вверх, чтобы поле не закрыла клавиатура. Поверх
            этого экран переписки добавляет собственный отступ под клавиатуру — и панель ввода
            уезжала на высоту клавиатуры выше нужного, а шапка экрана уходила за верхний край.
            С adjustResize система окно не трогает, а отступ считает приложение — один раз.
        -->
        <activity
            android:name=".main.ui.RootActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SecretMessanger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
